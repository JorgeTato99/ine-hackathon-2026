* text=auto
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.in text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.whl binary
temp/ export-ignore

# Las reglas especificas prevalecen sobre las extensiones generales.
/data/reference/*.csv text eol=lf
/data/samples/muestra-0.3/** -text
output/ export-ignore
artifacts/ export-ignore
