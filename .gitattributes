* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.sh text eol=lf
*.mts text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.toml text eol=lf
