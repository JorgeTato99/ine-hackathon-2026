{
  "name": "ine-hackathon-frontend",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "node scripts/build.mjs next",
    "serve": "serve out --listen tcp://127.0.0.1:4173 --no-clipboard",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --cache --cache-strategy content --cache-location .cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node scripts/test.mjs watch",
    "test:unit:run": "node scripts/test.mjs unit",
    "test:unit:coverage": "node scripts/test.mjs coverage",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "node scripts/test.mjs e2e",
    "test:e2e:ui": "node scripts/test.mjs e2e-ui",
    "test:e2e:report": "playwright show-report",
    "check": "node scripts/check.mjs",
    "validate": "node scripts/check.mjs --full",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "node scripts/build.mjs storybook",
    "docker:dev:up": "docker compose -f docker-compose.dev.yaml up -d --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yaml down",
    "docker:prod:up": "docker compose -f docker-compose.prod.yaml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yaml down",
    "test": "node scripts/test.mjs unit",
    "test:all": "node scripts/check.mjs --tests",
    "test:all:run": "node scripts/check.mjs --tests --reuse-build",
    "test:all:ligero": "node scripts/check.mjs --tests --profile=ligero",
    "test:all:rapido": "node scripts/check.mjs --tests --profile=rapido",
    "test:bench": "uv --no-config run --no-project --python 3.14 python test/tools/benchmark.py",
    "test:bench:profiles": "uv --no-config run --no-project --python 3.14 python test/tools/compare_profiles.py"
  },
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    }
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.3.0",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@tanstack/react-query": "5.104.4",
    "leaflet": "1.9.4",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/nextjs-vite": "10.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "serve": "14.2.6",
    "storybook": "10.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vitest-fail-on-console": "0.10.1"
  }
}
